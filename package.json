{
  "name": "legacylab-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "db:local": "wrangler d1 migrations apply DB --local && wrangler d1 execute DB --local --file=seed.sql",
    "db:remote": "wrangler d1 migrations apply DB --remote && wrangler d1 execute DB --remote --file=seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "lucide-react": "1.61.0",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7",
    "@better-auth/drizzle-adapter": "1.7.12"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "@cloudflare/workers-types": "5.20261024.1",
    "wrangler": "4.152.0",
    "esbuild": "0.28.2",
    "vitest": "5.0.5",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0",
    "miniflare": "5.20261019.2-beta"
  }
}
